{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build && npm test",
  "outputDirectory": "website",
  "redirects": [
    {
      "source": "/assets/autokonvert.user.js",
      "destination": "/assets/autoconvert.user.js",
      "permanent": true
    },
    {
      "source": "/assets/autokonvert-extension.zip",
      "destination": "/assets/autoconvert-extension.zip",
      "permanent": true
    },
    {
      "source": "/assets/template-logbook-autokonvert.xlsx",
      "destination": "/assets/template-logbook-autoconvert.xlsx",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/autoconvert.user.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/autoconvert-extension.zip",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/template-logbook-autoconvert.xlsx",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
